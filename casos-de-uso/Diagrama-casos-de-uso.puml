@startuml
title Bolonha e Milano - Casos de Uso - Etapa 4

left to right direction

' Ator que interage com o sistema
actor "Jogador" as J

rectangle "Sistema Bolonha e Milano" {

    usecase "Iniciar novo jogo" as UC1
    usecase "Consultar status da cidade" as UC2

    usecase "Acessar mercado" as UC3
    usecase "Comprar graos" as UC4
    usecase "Vender graos" as UC5
    usecase "Comprar terras" as UC6
    usecase "Vender terras" as UC7

    usecase "Acessar agricultura" as UC8
    usecase "Processar colheita" as UC9
    usecase "Distribuir alimentos" as UC10

    usecase "Consultar informacoes do jogo" as UC11
    usecase "Sair do jogo" as UC12
}

' Funcionalidades acessadas pelo jogador
J --> UC1
J --> UC2
J --> UC3
J --> UC8
J --> UC11
J --> UC12

' Operacoes disponíveis no mercado
UC4 ..> UC3 : <<extend>>
UC5 ..> UC3 : <<extend>>
UC6 ..> UC3 : <<extend>>
UC7 ..> UC3 : <<extend>>

' Operacoes disponíveis na agricultura
UC9 ..> UC8 : <<extend>>
UC10 ..> UC8 : <<extend>>

@enduml
